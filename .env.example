# ═══════════════════════════════════════════════════════════════
#  Enterprise Agentic RAG — Environment Variables
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit your real `.env` file.
# ═══════════════════════════════════════════════════════════════

# ─── 🧠 LLMs (Groq) ────────────────────────────────────────────
# Get keys at: https://console.groq.com/keys
GROQ_API_KEY=                # Primary — Planner + Responder nodes
GROQ_FALLBACK_API_KEY=       # Second Groq key (Portkey fallback target)

# ─── 🔀 LLM Gateway (Portkey) ──────────────────────────────────
# Get key at: https://portkey.ai (Dashboard → API Keys)
PORTKEY_API_KEY=

# ─── 🌐 Gemini Embeddings (Google) ─────────────────────────────
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── 🗄️ Vector Database (Qdrant Cloud) ─────────────────────────
# Create cluster at: https://cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=     # e.g. https://your-cluster.cloud.qdrant.io:6333

# ─── 🕵️ Observability ──────────────────────────────────────────
# Logfire: https://logfire.pydantic.dev
LOGFIRE_TOKEN=
# LangSmith: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise_rag
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─── 🧪 Evals (separate Groq key so testing never rate-limits prod) ──
JUDGE_GROQ=

# ─── 🖥️ Backend ────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
